SPOTDL_DATA_DIR=./data
# Optional: use your own Spotify developer credentials with the official API.
# Both values must be present to enable official API mode.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional Netscape-format YouTube cookies file, readable by the server.
SPOTDL_COOKIE_FILE=
# Seconds allowed per preview / per download job.
SPOTDL_PREVIEW_TIMEOUT=180
SPOTDL_DOWNLOAD_TIMEOUT=7200
