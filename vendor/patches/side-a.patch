+def _cached_metadata(function):
+    """Side A: reuse public catalog responses within one metadata-resolution worker."""
+    @wraps(function)
+    def cached(self, identifier, *args, **kwargs):
+        key = (function.__name__, self.urlToId(identifier) if self.isUrl(identifier) else identifier)
+        with self._catalog_lock:
+            if key in self._catalog_cache:
+                return copy.deepcopy(self._catalog_cache[key])
+            result = function(self, identifier, *args, **kwargs)
+            self._catalog_cache[key] = copy.deepcopy(result)
+            return result
+    return cached
